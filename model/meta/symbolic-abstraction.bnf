(* Semantic naming and annotation rules supplement this grammar; see
   symbolic-abstraction-rules.md. Fresh-name uniqueness is a semantic
   constraint and is not expressed by these BNF productions. *)

<annotation> ::= <element-annotation> |
                 <summary-annotation> |
                 <data-model-annotation> |
                 <abstract-model-annotation> |
                 <abstract-collection-annotation> |
                 <abstract-collection-instantiation>

<element-annotation> ::= "/* @-" <element-tag> <element-list> <comment-close> <source-newline> <source-line>
<element-tag> ::= <type-prefix> <function> <element-locator>
<type-prefix> ::= <go-type> "." | ""
<element-locator> ::= "#" <element-id> | "()"
<element-list> ::= <relates> <maybe-inline-elements> <maybe-summary-invariant-list> <maybe-state-list>
<maybe-inline-elements> ::= <inline-elements> | ""
<inline-elements> ::= <element-label-list> | <element-label-list> <newline> "  " <inline-alias> | <inline-alias>
<element-label-list> ::= <element-label> | <element-label> ", " <element-label-list>
<element-label> ::= "predicate" | "panic" | "loophead" | "call"
<source-line> ::= (a single line of source code in the golang program)

<summary-annotation> ::= "/* @+" <summary-tag> <relates> <alias> <maybe-summary-invariant-list> <comment-close>
<summary-tag> ::= <go-type> "." <function>
<function> ::= <function-name> | <function-signature>

<data-model-annotation> ::= "/* @+" <data-model-tag> " " <data-model-name> " " <go> <comment-close>
<data-model-tag> ::= <go-type> ": data-model"

<abstract-model-annotation> ::= "/* @^" <abstraction-name> <maybe-induction-goal> "(" <maybe-abstraction-parameters> ")" <maybe-equivalence-set> ":" <source-newline> <go+> <comment-close>
<maybe-abstraction-parameters> ::= <abstraction-parameter-list> | ""
<abstraction-parameter-list> ::= <abstraction-parameter> | <abstraction-parameter> ", " <abstraction-parameter-list>
<abstraction-parameter> ::= <variable-name> " " <go-type>
<abstraction-invocation> ::= <abstraction-name> "(" <maybe-abstraction-arguments> ")"
<maybe-abstraction-arguments> ::= <abstraction-argument-list> | ""
<abstraction-argument-list> ::= <go-expression> | <go-expression> ", " <abstraction-argument-list>
<abstract-model-call> ::= "@" <abstraction-invocation>

<abstract-collection-annotation> ::= "/* @=" <abstract-collection> " " <comment-close>
<abstract-collection> ::= <abstract-set> | <abstract-list>
<abstract-set> ::= "{" <abstract-data-structure> "}"
<abstract-list> ::= "[" <abstract-data-structure> "]"
<abstract-data-structure> ::= <abstract-collection-name> " " <go-type>
<abstract-collection-instantiation> ::= "/* @==" <abstract-collection-name> " */"

<maybe-summary-invariant-list> ::= <summary-invariant-list> | ""
<summary-invariant-list> ::= <summary-invariant> | <summary-invariant> <summary-invariant-list>
<summary-invariant> ::= <newline> "  " <invariant>
<maybe-substitution-invariant-list> ::= <substitution-invariant-list> | ""
<substitution-invariant-list> ::= <substitution-invariant> | <substitution-invariant> <substitution-invariant-list>
<substitution-invariant> ::= <newline> "    " <invariant>
<invariant> ::= <invariant-mode> <invariant-role> <maybe-induction-goal> ": " <invariant-definition>
<invariant-mode> ::= "(!)" | "(?)"
<invariant-role> ::= "pre-condition" | "post-condition"
<invariant-definition> ::= <go> | <abstraction-invocation>

<maybe-state-list> ::= <state-list> | ""
<state-list> ::= <state> | <state> <state-list>
<state> ::= <newline> "  (+)state[" <abstract-collection-name> "]: " <state-operator> <go-expression>
<state-operator> ::= "∪" | "∩" | "\\"

<maybe-induction-goal> ::= <induction-goal> | ""
<induction-goal> ::= "[" <induction-goal-tag> "]"
<maybe-equivalence-set> ::= <equivalence-set> | ""
<equivalence-set> ::= " <=> {" <induction-goal-list> "}"
<induction-goal-list> ::= <induction-goal-tag> | <induction-goal-tag> "," <maybe-space> <induction-goal-list>

<alias> ::= <inline-alias> | <newline> "  " <inline-alias>
<inline-alias> ::= "alias " <alias-definition>
<alias-definition> ::= <alias-inline> | <alias-model>
<alias-inline> ::= <go> <substitution-list>
<alias-model> ::= <abstraction-invocation> <substitution-list>
<substitution-list> ::= <newline> "  " <substitution> <substitution-list> | ""
<substitution> ::= "%values[" <index> "]:" <value-list> <maybe-substitution-invariant-list>
<value-list> ::= <value> | <value> <value-list>
<value> ::= <newline> "  " <variable> " " <go-type> <relates> <go>
<index> ::= (numeric, distinct per <alias>)
<variable> ::= "%" <variable-name>


<relates> ::= ":" <maybe-space>
<newline> ::= <source-newline> <spaces> "* "
<source-newline> ::= "\n" | "\r\n"
<spaces> ::= "" | " " <spaces>
<maybe-space> ::= " " | ""
<comment-close> ::= "*/" | <source-newline> <spaces> "*/"

<go> ::= (free-form inline golang, non-empty, excluding newline and "*/",
          possibly containing <variable> for <substitution-list>,
          extended with <abstract-model-call> in expression positions allowing type bool)
<go+> ::= (free-form golang, non-empty, including newlines but excluding C-style comments and excluding
           an unmatched closing comment; taken semantically as <body> in `func(...) (bool) { <body> }`;
           if <body> contains no `return`, assume a tacet prepended one, i.e., `return <body>`;
           <body> may be extended with <abstract-model-call> in expression positions allowing type bool)
<go-type> ::= (any valid golang type specifier)
<go-expression> ::= (a valid golang expression with the following limitations:
                     - identifiers must occur in the scope of the invocation
                     - no side effects or variable assignments are allowed
                     - every dot-dereferenced pointer must be proven non-nil,
                       otherwise analysis stops with an "unknown value flow" error
                     - every subscripted variable must be resolved to the same kind of collection
                       on all value flow paths, limited to base kinds { array, slice, map }, where:
                       - array size and slice length may differ per value flow path
                       - array/slice subscript(s) must resolve within bounds per path
                       - missing map values resolve to the map value type's zero value
                       - any resolution failure results in "unknown value flow")
<function-signature> ::= (a non-trivial golang function signature)
<element-id> ::= (an arbitrarily chosen name, referring to the <source-line> of the enclosing <element-annotation>)
<induction-goal-tag> ::= (alpha-numeric identifier)
